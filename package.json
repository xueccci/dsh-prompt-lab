{
  "name": "dsh-prompt-lab",
  "version": "0.1.0",
  "description": "Agent-structured prompt optimizer for DeepSeek Harness: one-click rewrite of the composer draft into role/task/context/constraint/format structure with local rules + optional LLM polish. DeepSeek Harness 输入栏 Agent 结构化提示词优化插件（普通/精简/扩写）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./shared": "./lib/shared.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node --test test/shared.test.mjs test/engine.test.mjs && node --check lib/index.js && node --check lib/shared.js && node --check lib/typert.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "optimizer",
    "agent",
    "composer"
  ],
  "license": "MIT",
  "author": "xueccci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueccci/dsh-prompt-lab.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
